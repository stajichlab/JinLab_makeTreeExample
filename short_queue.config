// Force every step onto the 2 h 'short' partition (user request).
process {
    // Keep every task off the AVX-only AMD Opteron 6376 ('abu_dhabi', c01-c30) nodes:
    // ASTRAL (aster 1.25) and the phyling 2.3.1 image's FastTree contain AVX2
    // instructions and die with SIGILL there. 'intel' = Broadwell/Cascade Lake,
    // 'ryzen' = Rome/Milan/Genoa; all have AVX2.
    clusterOptions = "--constraint='intel|ryzen'"
    queue = 'short'
    time  = 2.h
    withName: '.*' {
        queue = 'short'
        time  = 2.h
    }
    withName: 'PHYLING_ALIGN' {
        queue  = 'short'
        cpus   = 24
        memory = 48.GB
    }
    withName: 'MODELTEST_NG' { cpus = 16; memory = 32.GB }
}
