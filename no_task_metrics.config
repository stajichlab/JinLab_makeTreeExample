// The ghcr.io/stajichlab/phyling:2.4.1 image has no `ps`, which Nextflow needs
// to collect per-task metrics. Metrics are only collected when trace, timeline
// or report is enabled, so turn those three off. (Cost: no trace/timeline/report files.)
trace    { enabled = false }
timeline { enabled = false }
report   { enabled = false }
